{
  "name": "012s-activity-platform-functions",
  "private": true,
  "description": "Phase 1, Phase 2A, Phase 2B, and Phase 3A backend for the 2050 x 012S member activity platform.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "pnpm run build && firebase emulators:start --only functions,firestore,hosting",
    "emulator:cleanup": "node ../scripts/emulator-cleanup.mjs --all",
    "verify:integration": "node ../scripts/integration-smoke-test.mjs",
    "verify:invoice-draw": "node ../scripts/invoice-draw-integration-test.mjs",
    "verify:browser": "node ../scripts/frontend-browser-e2e.mjs",
    "shell": "pnpm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --pretty false"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
