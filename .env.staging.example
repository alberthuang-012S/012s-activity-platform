# Staging configuration example. Keep all project credentials and session tokens
# in the Firebase/CI secret store; do not commit a populated .env.staging file.
APP_ENV=staging
DEV_ADMIN_ENABLED=false
FUNCTIONS_REGION=asia-east1
DEV_SESSION_TTL_MINUTES=480
# Set this to the exact staging web origins. Never use *.
CORS_ALLOWED_ORIGINS=
# Set through the Firebase CLI/CI environment for the selected staging project.
FIREBASE_PROJECT_ID=
